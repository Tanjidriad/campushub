# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/campushub_pro
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/campushub_pro

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=CampusHub Pro <noreply@campushub.com>

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Frontend URLs (for email links & CORS)
FRONTEND_URL=http://localhost:3000
APP_URL=campushub://

# Redis (optional - for caching)
# REDIS_URL=redis://localhost:6379

# Firebase (optional - for push notifications)
# FIREBASE_SERVICE_ACCOUNT=your_firebase_service_account_json_or_base64
# Or place the JSON file at config/firebase-service-account.json

# Listing Configuration
LISTING_EXPIRY_DAYS=30
MAX_IMAGES_PER_LISTING=5
